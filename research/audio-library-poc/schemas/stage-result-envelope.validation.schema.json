{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Artifact Kind",
          "type": "string"
        },
        "durable": {
          "default": false,
          "title": "Durable",
          "type": "boolean"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_kind",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "JsonValue": {},
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "counters": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counters",
          "type": "object"
        },
        "duration_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "measurements": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Measurements",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "Metrics",
      "type": "object"
    },
    "StageIdentity": {
      "additionalProperties": false,
      "description": "All output-defining provenance for one deterministic stage run.",
      "properties": {
        "code_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "implementation_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Implementation Version",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Identifier"
        },
        "model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Sha256"
        },
        "output_schema_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Output Schema Version",
          "type": "string"
        },
        "stage_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Stage Kind",
          "type": "string"
        }
      },
      "required": [
        "stage_kind",
        "input_sha256",
        "implementation_version",
        "config_sha256",
        "output_schema_version",
        "code_revision"
      ],
      "title": "StageIdentity",
      "type": "object"
    },
    "TypedError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "TypedError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "cache_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TypedError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identity": {
      "$ref": "#/$defs/StageIdentity"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed_retryable",
        "failed_terminal",
        "paused",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "identity",
    "cache_key",
    "status",
    "attempt"
  ],
  "title": "StageResultEnvelope",
  "type": "object"
}
