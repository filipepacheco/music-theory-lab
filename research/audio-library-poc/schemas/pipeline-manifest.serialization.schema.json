{
  "$defs": {
    "JsonValue": {},
    "StageSpecification": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Config",
          "type": "object"
        },
        "implementation_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Implementation Version",
          "type": "string"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "model_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Identifier"
        },
        "model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Sha256"
        },
        "output_schema_version": {
          "default": "1.0.0",
          "maxLength": 128,
          "minLength": 1,
          "title": "Output Schema Version",
          "type": "string"
        },
        "stage_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Stage Kind",
          "type": "string"
        }
      },
      "required": [
        "stage_kind",
        "implementation_version"
      ],
      "title": "StageSpecification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code_revision": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Code Revision",
      "type": "string"
    },
    "pipeline_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Pipeline Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageSpecification"
      },
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "pipeline_id",
    "code_revision",
    "stages"
  ],
  "title": "PipelineManifest",
  "type": "object"
}
