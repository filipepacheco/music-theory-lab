{
  "$defs": {
    "AudioFormatFacts": {
      "additionalProperties": false,
      "properties": {
        "bit_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bit Rate"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "format_long_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Long Name"
        },
        "format_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Name"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "title": "AudioFormatFacts",
      "type": "object"
    },
    "AudioStreamFacts": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "codec_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec Name"
        },
        "codec_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec Type"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "sample_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        }
      },
      "required": [
        "index"
      ],
      "title": "AudioStreamFacts",
      "type": "object"
    },
    "CanonicalMetadata": {
      "additionalProperties": false,
      "properties": {
        "album": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Album"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "genres": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Genres"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "title": "CanonicalMetadata",
      "type": "object"
    },
    "DuplicateContent": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Source Paths",
          "type": "array"
        }
      },
      "required": [
        "sha256",
        "source_paths"
      ],
      "title": "DuplicateContent",
      "type": "object"
    },
    "JsonValue": {},
    "MetadataOrigin": {
      "enum": [
        "embedded",
        "filename",
        "missing"
      ],
      "title": "MetadataOrigin",
      "type": "string"
    },
    "MetadataOrigins": {
      "additionalProperties": false,
      "properties": {
        "album": {
          "$ref": "#/$defs/MetadataOrigin"
        },
        "artist": {
          "$ref": "#/$defs/MetadataOrigin"
        },
        "genres": {
          "$ref": "#/$defs/MetadataOrigin"
        },
        "title": {
          "$ref": "#/$defs/MetadataOrigin"
        },
        "year": {
          "$ref": "#/$defs/MetadataOrigin"
        }
      },
      "required": [
        "title",
        "artist",
        "album",
        "year",
        "genres"
      ],
      "title": "MetadataOrigins",
      "type": "object"
    },
    "MetadataResult": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "$ref": "#/$defs/CanonicalMetadata"
        },
        "duplicate_of_source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of Source Path"
        },
        "format": {
          "$ref": "#/$defs/AudioFormatFacts"
        },
        "origins": {
          "$ref": "#/$defs/MetadataOrigins"
        },
        "raw_format_tags": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Raw Format Tags",
          "type": "object"
        },
        "raw_stream_tags": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Raw Stream Tags",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/AudioStreamFacts"
          },
          "title": "Streams",
          "type": "array"
        }
      },
      "required": [
        "source_path",
        "source_sha256",
        "canonical",
        "origins",
        "format"
      ],
      "title": "MetadataResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duplicates": {
      "items": {
        "$ref": "#/$defs/DuplicateContent"
      },
      "title": "Duplicates",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/MetadataResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "results"
  ],
  "title": "SourceInspectionReport",
  "type": "object"
}
