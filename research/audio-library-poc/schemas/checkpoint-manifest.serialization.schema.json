{
  "$defs": {
    "CheckpointEntry": {
      "additionalProperties": false,
      "description": "One pinned checkpoint the workspace must materialize before inference.",
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "require_https": {
          "default": true,
          "title": "Require Https",
          "type": "boolean"
        },
        "target_filename": {
          "minLength": 1,
          "title": "Target Filename",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "url",
        "target_filename"
      ],
      "title": "CheckpointEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pinned checkpoint set for one deployment or bakeoff round.",
  "properties": {
    "checkpoints": {
      "items": {
        "$ref": "#/$defs/CheckpointEntry"
      },
      "minItems": 1,
      "title": "Checkpoints",
      "type": "array"
    },
    "manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "checkpoints"
  ],
  "title": "CheckpointManifest",
  "type": "object"
}
